{
 "nodes": [
  {
   "id": "base",
   "kind": "part",
   "title": "Lift base",
   "spec": "Flat 120x100x8 mm base plate. The NEMA 17 stepper hangs under it on the lead-screw axis, and the T8 lead screw rises through it. A short round boss on the underside, on the guide-rod axis, holds the fixed 8 mm guide rod upright. The joint rules cut the motor mount, the screw clearance and the rod socket.",
   "contract": {
    "name": "Lift base",
    "summary": "120x100x8 plate. The lead-screw axis is at -rodSpacing/2 on x and the guide-rod axis at +rodSpacing/2. Both joint faces are on the top face (+z). A rod-socket boss hangs below the guide axis.",
    "params": [
     {
      "type": "number",
      "name": "width",
      "description": "base length along x",
      "default": 120,
      "min": 90,
      "max": 200
     },
     {
      "type": "number",
      "name": "depth",
      "description": "base width along y",
      "default": 100,
      "min": 70,
      "max": 160
     },
     {
      "type": "number",
      "name": "thickness",
      "description": "how thick the base plate prints",
      "default": 8,
      "min": 5,
      "max": 15
     },
     {
      "type": "number",
      "name": "rodSpacing",
      "description": "distance between the lead-screw axis and the guide-rod axis",
      "default": 40,
      "min": 34,
      "max": 70
     },
     {
      "type": "number",
      "name": "rodBossHeight",
      "description": "how far the guide-rod socket boss hangs below the plate, giving the rod a deeper grip",
      "default": 16,
      "min": 6,
      "max": 30
     },
     {
      "type": "number",
      "name": "lift_pilot",
      "description": "motor pilot Ø for lift",
      "default": 22
     },
     {
      "type": "number",
      "name": "guide_rod_d",
      "description": "rod Ø for guide",
      "default": 8
     }
    ],
    "provides": [
     {
      "key": "lead_face",
      "type": "FLAT_FACE",
      "description": "top face on the lead-screw axis; the motor mounts under it and the screw rises through it"
     },
     {
      "key": "guide_face",
      "type": "FLAT_FACE",
      "description": "top face on the guide-rod axis; the 8 mm rod stands up from here"
     },
     {
      "key": "lift_motor_mount",
      "type": "MOTOR_MOUNT",
      "description": ""
     },
     {
      "key": "guide_rod",
      "type": "BORE",
      "description": ""
     }
    ],
    "requires": [],
    "payload": {
     "units": "mm",
     "process": {
      "kind": "FDM",
      "minWall": 1.2,
      "nozzle": 0.4
     },
     "ports": [
      {
       "name": "lead_face",
       "type": "FLAT_FACE",
       "pose": {
        "origin": [
         "-param(base.rodSpacing) / 2",
         0,
         "param(base.thickness) / 2"
        ],
        "zAxis": [
         0,
         0,
         1
        ],
        "xAxis": [
         1,
         0,
         0
        ]
       },
       "params": {
        "size": 30,
        "ring_diameter": 21.4
       }
      },
      {
       "name": "guide_face",
       "type": "FLAT_FACE",
       "pose": {
        "origin": [
         "param(base.rodSpacing) / 2",
         0,
         "param(base.thickness) / 2"
        ],
        "zAxis": [
         0,
         0,
         1
        ],
        "xAxis": [
         1,
         0,
         0
        ]
       },
       "params": {
        "size": 22,
        "ring_diameter": "(param(base.guide_rod_d)) + 2.4"
       }
      },
      {
       "name": "lift_motor_mount",
       "type": "MOTOR_MOUNT",
       "pose": {
        "origin": [
         "(-param(base.rodSpacing) / 2)",
         0,
         "(param(base.thickness) / 2) + (-(param(base.thickness)))"
        ],
        "zAxis": [
         0,
         0,
         -1
        ],
        "xAxis": [
         1,
         0,
         0
        ]
       },
       "params": {
        "pilot_diameter": "param(base.lift_pilot)",
        "hole_diameter": 3.4,
        "pitch_x": 31,
        "pitch_y": 31
       }
      },
      {
       "name": "guide_rod",
       "type": "BORE",
       "pose": {
        "origin": [
         "(param(base.rodSpacing) / 2)",
         0,
         "(param(base.thickness) / 2)"
        ],
        "zAxis": [
         0,
         0,
         1
        ],
        "xAxis": [
         1,
         0,
         0
        ]
       },
       "params": {
        "diameter": "param(base.guide_rod_d)",
        "depth": "(param(base.thickness) + param(base.rodBossHeight)) - 1.2"
       }
      }
     ],
     "envelope": {
      "volumes": [
       {
        "kind": "box",
        "pose": {
         "origin": [
          0,
          0,
          0
         ],
         "zAxis": [
          0,
          0,
          1
         ],
         "xAxis": [
          1,
          0,
          0
         ]
        },
        "dims": [
         "param(base.width)",
         "param(base.depth)",
         "param(base.thickness)"
        ]
       },
       {
        "kind": "cylinder",
        "pose": {
         "origin": [
          "param(base.rodSpacing) / 2",
          0,
          "-param(base.thickness) / 2 - param(base.rodBossHeight) / 2 + 0.5"
         ],
         "zAxis": [
          0,
          0,
          1
         ],
         "xAxis": [
          1,
          0,
          0
         ]
        },
        "d": 24,
        "h": "param(base.rodBossHeight) + 1"
       }
      ],
      "clearance": 0.4
     },
     "paramBindings": {
      "lift_pilot": "hw:motorPilot:param:lift_motor.sku",
      "guide_rod_d": "hw:shaftD:param:guide_rod.sku"
     },
     "visualChecks": [
      "Is the part a flat rectangular plate?",
      "Is there a round boss on the underside, offset to one side of center along x?",
      "Is there a square four-hole motor mount pattern on the opposite side of center from the boss?"
     ],
     "assertions": [
      {
       "kind": "bbox_axis",
       "axis": "x",
       "min": 119.5,
       "max": 120.5
      },
      {
       "kind": "bbox_axis",
       "axis": "y",
       "min": 99.5,
       "max": 100.5
      }
     ]
    }
   }
