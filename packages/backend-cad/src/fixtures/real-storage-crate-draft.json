        ]
       },
       "params": {
        "size": 12
       }
      },
      {
       "name": "right_end",
       "type": "FLAT_FACE",
       "pose": {
        "origin": [
         "param(slat-handle.length) / 2 - param(slat-handle.endInset)",
         0,
         "-param(slat-handle.thickness) / 2"
        ],
        "zAxis": [
         0,
         0,
         -1
        ],
        "xAxis": [
         0,
         1,
         0
        ]
       },
       "params": {
        "size": 12
       }
      },
      {
       "name": "hand_hold",
       "type": "SLOT",
       "pose": {
        "origin": [
         0,
         0,
         "param(slat-handle.thickness) / 2"
