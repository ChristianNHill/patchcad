{
  "schemaVersion": 1,
  "id": "cad-rotor",
  "backend": "cad",
  "brief": {
    "goal": "a rotor that spins freely on a base",
    "design": "Chunky printed parts, flat faces, edges left sharp.",
    "refs": []
  },
  "nodes": {
    "base": {
      "id": "base",
      "kind": "part",
      "title": "Base",
      "spec": "A round plate on three legs with a central tower that houses the rotor's bearings, one in each face.",
      "contract": {
        "name": "Base",
        "summary": "Ø90 plate on legs, Ø28 tower, rotor axis up its middle.",
        "params": [
          {
            "type": "number",
            "name": "housing_height",
            "description": "how tall the bearing tower is",
            "ui": {
              "unit": "mm"
            },
            "default": 14,
            "min": 12,
            "max": 30
          },
          {
            "type": "number",
            "name": "plate_diameter",
            "description": "plate width",
            "ui": {
              "unit": "mm"
            },
            "default": 90,
            "min": 60,
            "max": 160
          },
          {
            "type": "number",
            "name": "plate_thickness",
            "description": "plate thickness",
            "ui": {
              "unit": "mm"
            },
            "default": 4,
            "min": 3,
            "max": 8
          },
          {
            "type": "number",
            "name": "tower_diameter",
            "description": "tower width around the bearings",
            "ui": {
              "unit": "mm"
            },
            "default": 28,
            "min": 24,
            "max": 40
          },
          {
            "type": "number",
            "name": "leg_height",
            "description": "how far the legs lift the plate",
            "ui": {
              "unit": "mm"
            },
            "default": 10,
            "min": 8,
            "max": 30
          },
          {
            "type": "number",
            "name": "j1_seat_od",
            "description": "bearing OD for j1",
            "ui": {
              "unit": "mm"
            },
            "default": 16
          },
          {
            "type": "number",
            "name": "j1_seat_w",
            "description": "seat depth for j1",
            "ui": {
              "unit": "mm"
            },
            "default": 5
          }
        ],
        "provides": [
          {
            "key": "rotor_face",
            "type": "FLAT_FACE",
            "description": "top of the tower, where the rotor turns"
          },
          {
            "key": "j1_seat_a",
            "type": "BEARING_SEAT",
            "description": ""
          },
          {
            "key": "j1_seat_b",
            "type": "BEARING_SEAT",
            "description": ""
          }
        ],
        "requires": [],
        "payload": {
          "units": "mm",
          "process": {
            "kind": "FDM",
            "minWall": 1.2,
            "nozzle": 0.4
          },
          "paramBindings": {
            "j1_seat_od": "hw:bearingSeatD:param:j1_bearing_a.sku",
            "j1_seat_w": "hw:bearingWidth:param:j1_bearing_a.sku"
          },
          "ports": [
            {
              "name": "rotor_face",
              "type": "FLAT_FACE",
              "pose": {
                "origin": [
                  0,
                  0,
                  "param(base.housing_height)"
                ],
                "zAxis": [
                  0,
                  0,
                  1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "size": 28,
                "ring_diameter": "(param(base.j1_seat_od)) + 2.4"
              }
            },
            {
              "name": "j1_seat_a",
              "type": "BEARING_SEAT",
              "pose": {
                "origin": [
                  0,
                  0,
                  "(param(base.housing_height))"
                ],
                "zAxis": [
                  0,
                  0,
                  1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "od": "param(base.j1_seat_od)",
                "width": "param(base.j1_seat_w)",
                "fit": "press"
              }
            },
            {
              "name": "j1_seat_b",
              "type": "BEARING_SEAT",
              "pose": {
                "origin": [
                  0,
                  0,
                  "(param(base.housing_height)) + (-(param(base.housing_height)))"
                ],
                "zAxis": [
                  0,
                  0,
                  -1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "od": "param(base.j1_seat_od)",
                "width": "param(base.j1_seat_w)",
                "fit": "press"
              }
            }
          ],
          "envelope": {
            "volumes": [
              {
                "kind": "cylinder",
                "pose": {
                  "origin": [
                    0,
                    0,
                    "(param(base.housing_height) - param(base.leg_height)) / 2"
                  ],
                  "zAxis": [
                    0,
                    0,
                    1
                  ],
                  "xAxis": [
                    1,
                    0,
                    0
                  ]
                },
                "d": "param(base.plate_diameter) + 2",
                "h": "param(base.housing_height) + param(base.leg_height) + 1"
              }
            ],
            "clearance": 0.4
          }
        },
        "hash": "46977842c3089b32"
      },
      "params": {},
      "hidden": false,
      "artifact": {
