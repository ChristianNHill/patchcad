{
  "schemaVersion": 1,
  "id": "cad-belt-drive",
  "backend": "cad",
  "brief": {
    "goal": "a turntable driven 2:1 by a NEMA 17 through a GT2 belt",
    "design": "Chunky printed parts, flat faces, edges left sharp.",
    "refs": []
  },
  "nodes": {
    "base": {
      "id": "base",
      "kind": "part",
      "title": "Base",
      "spec": "A motor plate with a bearing tower at one end: the driven shaft runs in the tower, the NEMA 17 hangs under the plate beside it.",
      "contract": {
        "name": "Base",
        "summary": "6mm plate, Ø24 bearing tower 14 tall, NEMA 17 under the plate.",
        "params": [
          {
            "type": "number",
            "name": "housing_height",
            "description": "bearing tower height, the plate's top",
            "ui": {
              "unit": "mm"
            },
            "default": 14,
            "min": 12,
            "max": 30
          },
          {
            "type": "number",
            "name": "plate_thickness",
            "description": "plate thickness under the motor",
            "ui": {
              "unit": "mm"
            },
            "default": 6,
            "min": 4,
            "max": 10
          },
          {
            "type": "number",
            "name": "tower_diameter",
            "description": "tower width round the bearings",
            "ui": {
              "unit": "mm"
            },
            "default": 24,
            "min": 22,
            "max": 40
          },
          {
            "type": "number",
            "name": "plate_width",
            "description": "plate width across the drive",
            "ui": {
              "unit": "mm"
            },
            "default": 56,
            "min": 46,
            "max": 80
          },
          {
            "type": "number",
            "name": "j1_seat_od",
            "description": "bearing OD for j1",
            "ui": {
              "unit": "mm"
            },
            "default": 16
          },
          {
            "type": "number",
            "name": "j1_seat_w",
            "description": "seat depth for j1",
            "ui": {
              "unit": "mm"
            },
            "default": 5
          },
          {
            "type": "number",
            "name": "j1_pilot",
            "description": "motor pilot Ø for j1",
            "ui": {
              "unit": "mm"
            },
            "default": 22
          }
        ],
        "provides": [
          {
            "key": "top",
            "type": "FLAT_FACE",
            "description": "top of the tower, where the driven shaft comes out"
          },
          {
            "key": "j1_seat_a",
            "type": "BEARING_SEAT",
            "description": ""
          },
          {
            "key": "j1_seat_b",
            "type": "BEARING_SEAT",
            "description": ""
          },
          {
            "key": "j1_motor_mount",
            "type": "MOTOR_MOUNT",
            "description": "the motor's face, under a: pocket a's underside around the 42.3 square body up to here"
          }
        ],
        "requires": [],
        "payload": {
          "units": "mm",
          "process": {
            "kind": "FDM",
            "minWall": 1.2,
            "nozzle": 0.4
          },
          "ports": [
            {
              "name": "top",
              "type": "FLAT_FACE",
              "pose": {
                "origin": [
                  0,
                  0,
                  "param(base.housing_height)"
                ],
                "zAxis": [
                  0,
                  0,
                  1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "size": 24,
                "ring_diameter": "(param(base.j1_seat_od)) + 2.4"
              }
            },
            {
              "name": "j1_seat_a",
              "type": "BEARING_SEAT",
              "pose": {
                "origin": [
                  0,
                  0,
                  "(param(base.housing_height))"
                ],
                "zAxis": [
                  0,
                  0,
                  1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "od": "param(base.j1_seat_od)",
                "width": "param(base.j1_seat_w)",
                "fit": "press"
              }
            },
            {
              "name": "j1_seat_b",
              "type": "BEARING_SEAT",
              "pose": {
                "origin": [
                  0,
                  0,
                  "(param(base.housing_height)) + (-(param(base.housing_height)))"
                ],
                "zAxis": [
                  0,
                  0,
                  -1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "od": "param(base.j1_seat_od)",
                "width": "param(base.j1_seat_w)",
                "fit": "press"
              }
            },
            {
              "name": "j1_motor_mount",
              "type": "MOTOR_MOUNT",
              "pose": {
                "origin": [
                  48.58,
                  0,
                  "(param(base.housing_height)) + (-(param(base.plate_thickness)))"
                ],
                "zAxis": [
                  0,
                  0,
                  -1
                ],
                "xAxis": [
                  1,
                  0,
                  0
                ]
              },
              "params": {
                "pilot_diameter": "param(base.j1_pilot)",
                "hole_diameter": 3.4,
                "pitch_x": 31,
                "pitch_y": 31
              }
            }
          ],
          "envelope": {
            "volumes": [
              {
                "kind": "cylinder",
                "pose": {
                  "origin": [
                    0,
                    0,
                    "param(base.housing_height) / 2"
                  ],
                  "zAxis": [
                    0,
                    0,
                    1
                  ],
                  "xAxis": [
                    1,
                    0,
                    0
                  ]
                },
                "d": "param(base.tower_diameter) + 1",
                "h": "param(base.housing_height) + 1"
              },
              {
                "kind": "box",
                "pose": {
                  "origin": [
                    30,
                    0,
                    "param(base.housing_height) - param(base.plate_thickness) / 2"
                  ],
                  "zAxis": [
                    0,
                    0,
                    1
                  ],
                  "xAxis": [
                    1,
                    0,
                    0
                  ]
                },
                "dims": [
                  112,
                  "param(base.plate_width) + 1",
                  "param(base.plate_thickness) + 1"
                ]
              }
            ],
            "clearance": 0.4
          },
          "paramBindings": {
            "j1_seat_od": "hw:bearingSeatD:param:j1_bearing_a.sku",
            "j1_seat_w": "hw:bearingWidth:param:j1_bearing_a.sku",
            "j1_pilot": "hw:motorPilot:param:j1_motor.sku"
          }
        },
        "hash": "cc6313d635c50942"
      },
